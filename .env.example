# Valores de desenvolvimento do docker-compose.yml. Nenhum é segredo real.
# Os hosts abaixo valem DENTRO da rede do compose; rodando o código direto na sua máquina,
# troque `postgres`, `storage` e `llm-mock` por `localhost` (e a porta do mock por 8090).

DATABASE_URL=postgres://desafio:desafio@postgres:5432/tasks

S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=tasks-files

LLM_BASE_URL=http://llm-mock:8080
LLM_API_KEY=mock-dev-key
